{
  "schemaVersion": 1,
  "id": "kimi",
  "name": "Kimi Code",
  "icon": "logo.svg",
  "staticRoot": "/usr/share/kimi/www",
  "desktop": {
    "mode": "iframe",
    "target": {
      "scheme": "http",
      "hostMode": "request-host",
      "port": {
        "default": 7686,
        "keys": { "uci": "kimi.main.terminal_port" }
      },
      "path": "/apps/kimi/"
    },
    "access": {
      "scope": "lan",
      "blockedTitle": "请在局域网内打开 Kimi Code",
      "blockedMessage": "Kimi Code 终端只通过设备的认证应用网关提供。"
    }
  },
  "standalone": {
    "basePath": "/apps/kimi/",
    "externalOpen": {
      "enabled": true,
      "label": "打开 Kimi Code 终端"
    }
  },
  "auth": { "mode": "default" },
  "backend": {
    "type": "http",
    "scheme": "http",
    "host": "127.0.0.1",
    "portFromUci": "kimi.main.terminal_port",
    "defaultPort": 7686,
    "upstreamBasePath": "/apps/kimi/",
    "pathMode": "preserve",
    "proxyMode": "app-base"
  },
  "window": { "width": 1180, "height": 760, "singleton": true },
  "capabilities": ["coding-agent", "terminal", "development"],
  "categories": ["development", "ai"]
}
